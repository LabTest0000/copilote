            }
        )

        column ID (
            reportColumnQueryId: 1
            derivedColumn: N
            heading {
                heading: ID
                alignment: end
            }
            layout {
                sequence: 10
                columnAlignment: end
            }
            sorting {
                sortable: false
            }
        )

        column JAPONAIS (
            reportColumnQueryId: 9
            derivedColumn: N
            heading {
                heading: Japonais
            }
            layout {
