page 6 (
    name: Carte du monde
    alias: CARTE-DU-MONDE
    title: Carte du monde
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    security {
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region world-map (
        name: Carte du monde
        type: staticContent
        source {
            htmlCode:
                ```html
                <div style="max-width: 1080px; margin: 0 auto; padding: 8px 0;">
                  <p style="margin-bottom: 16px;">Cette region HTML affiche une carte du monde integree directement dans la page.</p>
                  <div style="background: linear-gradient(180deg, #eaf6ff 0%, #d5ecff 100%); border: 1px solid #bfdcf2; border-radius: 16px; padding: 18px; box-shadow: 0 10px 24px rgba(10, 61, 98, 0.08); overflow-x: auto;">
                    <div role="img" aria-label="Carte du monde stylisee" style="position: relative; min-width: 720px; height: 360px; border-radius: 14px; background: linear-gradient(180deg, #cae9ff 0%, #b9e0ff 100%); overflow: hidden;">
                      <div style="position: absolute; top: 34px; left: 78px; width: 145px; height: 100px; background: #5f9f68; border: 4px solid #4b8052; border-radius: 52% 48% 45% 55% / 48% 55% 45% 52%; transform: rotate(-8deg);"></div>
                      <div style="position: absolute; top: 126px; left: 170px; width: 72px; height: 100px; background: #5f9f68; border: 4px solid #4b8052; border-radius: 45% 55% 50% 50% / 35% 40% 60% 65%; transform: rotate(10deg);"></div>
                      <div style="position: absolute; top: 42px; left: 298px; width: 228px; height: 108px; background: #5f9f68; border: 4px solid #4b8052; border-radius: 44% 56% 41% 59% / 50% 44% 56% 50%; transform: rotate(2deg);"></div>
                      <div style="position: absolute; top: 128px; left: 398px; width: 92px; height: 146px; background: #5f9f68; border: 4px solid #4b8052; border-radius: 46% 54% 43% 57% / 38% 42% 58% 62%; transform: rotate(6deg);"></div>
                      <div style="position: absolute; top: 58px; left: 566px; width: 214px; height: 104px; background: #5f9f68; border: 4px solid #4b8052; border-radius: 48% 52% 44% 56% / 45% 48% 52% 55%; transform: rotate(4deg);"></div>
                      <div style="position: absolute; top: 186px; left: 676px; width: 84px; height: 58px; background: #5f9f68; border: 4px solid #4b8052; border-radius: 56% 44% 55% 45% / 50% 45% 55% 50%; transform: rotate(-12deg);"></div>
                      <div style="position: absolute; top: 262px; left: 782px; width: 48px; height: 30px; background: #5f9f68; border: 4px solid #4b8052; border-radius: 55% 45% 60% 40% / 50% 45% 55% 50%; transform: rotate(14deg);"></div>
                      <div style="position: absolute; top: 40px; left: 122px; width: 42px; height: 42px; background: rgba(255,255,255,0.42); border-radius: 50%;"></div>
                      <div style="position: absolute; top: 30px; left: 416px; width: 56px; height: 56px; background: rgba(255,255,255,0.42); border-radius: 50%;"></div>
                      <div style="position: absolute; top: 52px; left: 698px; width: 46px; height: 46px; background: rgba(255,255,255,0.42); border-radius: 50%;"></div>
                    </div>
                  </div>
                </div>
                ```
        }
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: #DEFAULT#
        }
    )

)