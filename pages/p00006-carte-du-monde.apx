page 6 (
    name: Carte du monde
    alias: CARTE-DU-MONDE
    title: Carte du monde
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    security {
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region world-map (
        name: Carte du monde
        type: staticContent
        source {
            htmlCode:
                ```html
                <div style="max-width: 1080px; margin: 0 auto; padding: 8px 0;">
                  <p style="margin-bottom: 16px;">Cette region HTML affiche une photo satellite du monde stockee comme fichier statique de l'application.</p>
                  <figure style="margin: 0; background: linear-gradient(180deg, #f3fbff 0%, #dcefff 100%); border: 1px solid #bfdcf2; border-radius: 16px; padding: 18px; box-shadow: 0 10px 24px rgba(10, 61, 98, 0.08);">
                    <img src="#APP_FILES#world/world-map-photo.jpg" alt="Photo satellite du monde" style="display: block; width: 100%; height: auto; border-radius: 14px;" />
                    <figcaption style="margin-top: 12px; color: #35556b; font-size: 0.95rem;">Image source: NASA Blue Marble, utilisee ici comme illustration libre de droit.</figcaption>
                  </figure>
                  </div>
                </div>
                ```
        }
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: #DEFAULT#
        }
    )

)